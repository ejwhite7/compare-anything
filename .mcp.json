{
  "mcpServers": {
    "compare-anything": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/main.mjs"
      ],
      "env": {
        "COMPARE_ANYTHING_OPENROUTER_KEY": "${user_config.openrouter_api_key}",
        "COMPARE_ANYTHING_JEV": "${COMPARE_ANYTHING_JEV:-}",
        "COMPARE_ANYTHING_DATA": "${COMPARE_ANYTHING_DATA:-}",
        "COMPARE_ANYTHING_PORT": "${COMPARE_ANYTHING_PORT:-}"
      }
    }
  }
}
