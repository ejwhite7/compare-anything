{
  "mcpServers": {
    "compare-anything": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/main.mjs"],
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY:-}",
        "COMPARE_ANYTHING_JEV": "${COMPARE_ANYTHING_JEV:-}",
        "COMPARE_ANYTHING_DATA": "${COMPARE_ANYTHING_DATA:-}",
        "COMPARE_ANYTHING_PORT": "${COMPARE_ANYTHING_PORT:-}"
      }
    }
  }
}
